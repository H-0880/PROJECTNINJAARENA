+
+    UPROPERTY(BlueprintReadOnly)
+    float HealthDamage = 0.f;
+
+    UPROPERTY(BlueprintReadOnly)
+    float KnockbackScale = 1.f;
+
+    UPROPERTY(BlueprintReadOnly)
